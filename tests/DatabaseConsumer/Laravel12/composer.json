{
    "name": "cluion/migrafold-database-consumer-laravel-12",
    "description": "Real database consumer acceptance for Migrafold on Laravel 12.",
    "type": "project",
    "license": "MIT",
    "repositories": [
        {
            "type": "path",
            "url": "../artifact",
            "options": {
                "symlink": false,
                "versions": {
                    "cluion/migrafold": "dev-main"
                }
            }
        }
    ],
    "require": {
        "php": "^8.2",
        "cluion/migrafold": "dev-main",
        "cluion/moduark": "^1.3",
        "laravel/framework": "^12.0",
        "nwidart/laravel-modules": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Modules\\": "Modules/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "config": {
        "allow-plugins": {
            "wikimedia/composer-merge-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
