#!/usr/bin/env sh

set -eu

# shellcheck disable=SC1007
consumer_root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
# shellcheck disable=SC1007
project_root=$(CDPATH= cd -- "$consumer_root/../.." && pwd)
temporary_root=${TMPDIR:-/tmp}
workspace=$(mktemp -d "$temporary_root/migrafold-database-consumer.XXXXXX")
artifact_root="$workspace/artifact"
requested_laravel=${MIGRAFOLD_CONSUMER_LARAVEL:-all}
requested_database=${MIGRAFOLD_CONSUMER_DATABASE:-all}
requested_disposition=${MIGRAFOLD_CONSUMER_DISPOSITION:-archive}
package_source=${MIGRAFOLD_CONSUMER_PACKAGE_SOURCE:-archive}

cleanup() {
    rm -rf "$workspace"
}

trap cleanup EXIT INT TERM

case "$requested_laravel" in
    12)
        suites='Laravel12'
        ;;
    13)
        suites='Laravel13'
        ;;
    all)
        suites='Laravel12 Laravel13'
        ;;
    *)
        echo 'MIGRAFOLD_CONSUMER_LARAVEL must be 12, 13, or all.' >&2
        exit 1
        ;;
esac

case "$requested_disposition" in
    archive|delete)
        ;;
    *)
        echo 'MIGRAFOLD_CONSUMER_DISPOSITION must be archive or delete.' >&2
        exit 1
        ;;
esac

case "$requested_database" in
    mysql|mariadb|postgres16|postgres17)
        database_targets=$requested_database
        ;;
    postgres)
        database_targets='postgres16 postgres17'
        ;;
    all)
        database_targets='mysql mariadb postgres16 postgres17'
        ;;
    *)
        echo 'MIGRAFOLD_CONSUMER_DATABASE must be mysql, mariadb, postgres16, postgres17, postgres, or all.' >&2
        exit 1
        ;;
esac

case "$package_source" in
    archive|working-tree)
        ;;
    *)
        echo 'MIGRAFOLD_CONSUMER_PACKAGE_SOURCE must be archive or working-tree.' >&2
        exit 1
        ;;
esac

mkdir "$artifact_root"
git -C "$project_root" archive --format=tar --output="$workspace/migrafold.tar" HEAD
tar -xf "$workspace/migrafold.tar" -C "$artifact_root"

if [ "$package_source" = 'working-tree' ]; then
    cp "$project_root/composer.json" "$artifact_root/composer.json"
    cp -R "$project_root/config/." "$artifact_root/config"
    cp -R "$project_root/src/." "$artifact_root/src"
fi

if [ -e "$artifact_root/.git" ] || [ -e "$artifact_root/.internal" ] || [ -e "$artifact_root/tests" ]; then
    echo 'Database consumer artifact contains development-only files.' >&2
    exit 1
fi

for suite in $suites; do
    suite_root="$workspace/$suite"

    mkdir "$suite_root"
    cp -R "$project_root/tests/Consumer/App/." "$suite_root"
    cp -R "$consumer_root/App/." "$suite_root"
    cp "$consumer_root/$suite/composer.json" "$suite_root/composer.json"
    mkdir -p \
        "$suite_root/storage/framework/cache" \
        "$suite_root/storage/framework/sessions" \
        "$suite_root/storage/framework/views" \
        "$suite_root/storage/logs"

    php "$suite_root/generate.php"
    composer install --working-dir="$suite_root" --no-interaction --no-progress --prefer-dist
    composer audit --locked --no-interaction --working-dir="$suite_root"

    package_root="$suite_root/vendor/cluion/migrafold"

    if [ ! -d "$package_root" ] || [ -L "$package_root" ]; then
        echo "$suite did not install an independent Migrafold package copy." >&2
        exit 1
    fi

    if [ -e "$package_root/tests" ] || [ -e "$package_root/.internal" ]; then
        echo "$suite installed development-only Migrafold files." >&2
        exit 1
    fi

    for target in $database_targets; do
        case "$target" in
            mysql)
                driver=mysql
                port=13306
                database=migrafold_mysql_testing
                username=root
                expected_server_major=''
                ;;
            mariadb)
                driver=mariadb
                port=13307
                database=migrafold_mariadb_testing
                username=root
                expected_server_major=''
                ;;
            postgres16)
                driver=pgsql
                port=15432
                database=migrafold_postgres16_testing
                username=migrafold
                expected_server_major=16
                ;;
            postgres17)
                driver=pgsql
                port=15433
                database=migrafold_postgres17_testing
                username=migrafold
                expected_server_major=17
                ;;
        esac

        php "$suite_root/generate.php"

        (
            cd "$suite_root"
            APP_ENV=testing \
            APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA= \
            DB_CONNECTION="$driver" \
            DB_HOST=127.0.0.1 \
            DB_PORT="$port" \
            DB_DATABASE="$database" \
            DB_USERNAME="$username" \
            DB_PASSWORD=migrafold \
            DB_URL='' \
            MIGRAFOLD_EXPECTED_SERVER_MAJOR="$expected_server_major" \
            MIGRAFOLD_CONSUMER_DISPOSITION="$requested_disposition" \
            php accept.php
        )
    done
done
