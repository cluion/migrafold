#!/usr/bin/env sh

set -eu

interop_root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

for suite in Laravel12 Laravel13; do
    suite_root="$interop_root/$suite"
    suite_slug=$(printf '%s' "$suite" | tr '[:upper:]' '[:lower:]')
    expected_test_database="/tmp/migrafold_moduark_${suite_slug}_testing"
    test_database=$(sed -n 's/.*<env name="DB_DATABASE" value="\([^"]*\)".*/\1/p' "$suite_root/phpunit.xml")

    if [ "$test_database" != "$expected_test_database" ]; then
        echo "Refusing unexpected Moduark test database [$test_database]; expected [$expected_test_database]." >&2
        exit 78
    fi

    if [ ! -f "$suite_root/.env" ]; then
        cp "$suite_root/.env.example" "$suite_root/.env"
    fi

    composer install --working-dir="$suite_root" --no-interaction --prefer-dist
    touch "$test_database"

    (
        cd "$suite_root"

        if command -v safe-laravel-test >/dev/null 2>&1; then
            DB_DATABASE="$test_database" safe-laravel-test --runner=phpunit
        else
            DB_DATABASE="$test_database" vendor/bin/phpunit
        fi
    )
done
