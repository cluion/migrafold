{
    "name": "cluion/migrafold-nwidart-laravel-12-interop",
    "description": "Isolated nWidart interoperability harness for Migrafold on Laravel 12.",
    "type": "project",
    "license": "MIT",
    "repositories": [
        {
            "type": "path",
            "url": "../../../..",
            "options": {
                "symlink": true
            }
        }
    ],
    "require": {
        "php": "^8.2",
        "cluion/migrafold": "dev-main",
        "laravel/framework": "^12.0",
        "nwidart/laravel-modules": "^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0",
        "phpunit/phpunit": "^11.5 || ^12.5 || ^13.0"
    },
    "autoload-dev": {
        "psr-4": {
            "MigrafoldInterop\\Nwidart\\": "../src/"
        }
    },
    "config": {
        "allow-plugins": {
            "wikimedia/composer-merge-plugin": true
        },
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "cluion/migrafold",
                "nwidart/laravel-modules"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
