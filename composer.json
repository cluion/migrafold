{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "cluion/migrafold",
    "description": "Fold Laravel migration history into verified, deploy-safe baselines.",
    "keywords": [
        "database",
        "laravel",
        "migration",
        "modules",
        "schema"
    ],
    "homepage": "https://github.com/cluion/migrafold",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Cluion"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/console": "^12.0 || ^13.0",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/filesystem": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11.5 || ^12.5 || ^13.0"
    },
    "suggest": {
        "cluion/moduark": "Enables runtime-backed discovery and table ownership for Moduark Modules."
    },
    "autoload": {
        "psr-4": {
            "Cluion\\Migrafold\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "post-autoload-dump": [
            "@prepare"
        ],
        "test": [
            "@prepare",
            "@php vendor/bin/phpunit"
        ],
        "test:databases": "tests/run-database-tests",
        "analyse": "@php vendor/bin/phpstan analyse --ansi --memory-limit=1G",
        "verify": [
            "@test",
            "@analyse"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Cluion\\Migrafold\\MigrafoldServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
